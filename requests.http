@baseUrl = http://localhost:3000
@cartId = replace-with-cart-id
@orderId = replace-with-order-id
@couponCode = SAVE10-REPLACE
@productId = prod_mouse

### Health
GET {{baseUrl}}/health

### List products
GET {{baseUrl}}/products

### Get product
GET {{baseUrl}}/products/{{productId}}

### Create cart
POST {{baseUrl}}/carts
Content-Type: application/json

### Get cart
GET {{baseUrl}}/carts/{{cartId}}

### Add cart item
POST {{baseUrl}}/carts/{{cartId}}/items
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 2
}

### Set cart item quantity
PUT {{baseUrl}}/carts/{{cartId}}/items/{{productId}}
Content-Type: application/json

{
  "quantity": 3
}

### Remove cart item
DELETE {{baseUrl}}/carts/{{cartId}}/items/{{productId}}

### Checkout
POST {{baseUrl}}/carts/{{cartId}}/checkout
Content-Type: application/json
Idempotency-Key: demo-idempotency-key-01

{}

### Checkout with coupon
POST {{baseUrl}}/carts/{{cartId}}/checkout
Content-Type: application/json
Idempotency-Key: demo-idempotency-key-02

{
  "couponCode": "{{couponCode}}"
}

### Get order
GET {{baseUrl}}/orders/{{orderId}}

### Admin: generate coupon
POST {{baseUrl}}/admin/coupons

### Admin: list coupons
GET {{baseUrl}}/admin/coupons

### Admin: report
GET {{baseUrl}}/admin/report
